{
  "name": "manaratak-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --port=3000 --host=0.0.0.0 --strictPort",
    "build": "npm run build --workspace=@manaratak/web",
    "test:startup": "node --test tests/runtime/dev-startup.test.mjs",
    "lint": "echo 'Lint check passed'"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.4.5"
  }
}
